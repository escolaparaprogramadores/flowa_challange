<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>OrderAccumulator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowa.Shared\Flowa.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="QuickFIXn.Core" Version="1.14.1" />
    <PackageReference Include="QuickFIXn.FIX44" Version="1.14.1" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- A sessão FIX e o dicionário FIX 4.4 (que vem dentro do pacote) ficam ao lado do executável. -->
  <ItemGroup>
    <None Update="acceptor.cfg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgQuickFIXn_FIX44)\DataDictionary\FIX44.xml" Link="FIX44.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
