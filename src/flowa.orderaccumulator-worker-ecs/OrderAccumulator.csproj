<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>Flowa.OrderAccumulator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Persistence\Schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuickFIXn.Core" Version="1.14.1" />
    <PackageReference Include="QuickFIXn.FIX44" Version="1.14.1" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\flowa.commons\Commons.csproj" />
  </ItemGroup>

  <!-- The FIX session and the FIX 4.4 dictionaries sit next to the executable: the package one from here, the one with tag 5100 from the Commons. -->
  <ItemGroup>
    <None Update="acceptor.cfg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgQuickFIXn_FIX44)\DataDictionary\FIX44.xml" Link="FIX44.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
