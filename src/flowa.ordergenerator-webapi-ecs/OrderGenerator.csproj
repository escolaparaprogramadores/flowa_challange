<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Flowa.OrderGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuickFIXn.Core" Version="1.14.1" />
    <PackageReference Include="QuickFIXn.FIX44" Version="1.14.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\flowa.commons\Commons.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrderGenerator.Tests" />
  </ItemGroup>

  <!-- The FIX session sits next to the executable; the FIX 4.4 dictionary with tag 5100 comes from the Commons. -->
  <ItemGroup>
    <!-- The Vite build (F5) also goes to the output, so dotnet run and the plain build serve the page. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="initiator.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
