<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>OrderGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Flowa.Shared/Flowa.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuickFIXn.Core" Version="1.14.1" />
    <PackageReference Include="QuickFIXn.FIX44" Version="1.14.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrderGenerator.Tests" />
  </ItemGroup>

  <!-- A sessão vai junto do binário; o dicionário (FIX44-flowa.xml) chega pelo Flowa.Shared. -->
  <ItemGroup>
    <!-- O build do Vite (F5) também vai para a saída, para dotnet run e o build comum servirem a página. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="initiator.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
