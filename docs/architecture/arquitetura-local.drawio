<mxfile>
  <diagram id="flowa-arquitetura-local" name="Flowa — arquitetura local">
    <mxGraphModel dx="1800" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1060" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="&lt;b&gt;Flowa — arquitetura local&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="36" as="geometry"/></mxCell>
        <mxCell id="subtitulo" value="Tudo roda na máquina com &lt;i&gt;docker compose up&lt;/i&gt;. Fonte: docs/contracts/contracts.md (seções 1 a 6)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1100" height="24" as="geometry"/></mxCell>
        <mxCell id="compose" value="&lt;b&gt;docker compose&lt;/b&gt; · rede interna (só a porta 8080 é publicada para fora)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#3E4C59;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=15;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="360" y="140" width="1380" height="760" as="geometry"/></mxCell>
        <mxCell id="porta8080" value="&lt;b&gt;8080&lt;/b&gt;&lt;br&gt;publicada" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fontColor=#1F2933;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="300" width="80" height="44" as="geometry"/></mxCell>
        <mxCell id="navegador" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tela React + Vite&lt;br&gt;servida pelo OrderGenerator&lt;br&gt;na raiz &lt;b&gt;/&lt;/b&gt;&lt;br&gt;&lt;br&gt;http://localhost:8080" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=14;fontFamily=Helvetica;fontColor=#1F2933;fillColor=#FFFFFF;strokeColor=#52606D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="260" height="220" as="geometry"/></mxCell>
        <mxCell id="ordergenerator" value="&lt;b&gt;OrderGenerator&lt;/b&gt; · .NET 10&lt;br&gt;&lt;span style=&quot;color:#52606D&quot;&gt;serviço &lt;i&gt;ordergenerator&lt;/i&gt; · HTTP 8080&lt;/span&gt;&lt;br&gt;&lt;br&gt;Serve a tela em &lt;b&gt;/&lt;/b&gt;&lt;br&gt;POST /api/orders (manda por FIX)&lt;br&gt;GET /api/exposures, GET /api/orders,&lt;br&gt;DELETE /api/orders (direto no banco)&lt;br&gt;FIX initiator · ORDERGENERATOR" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=14;fontFamily=Helvetica;fontColor=#1F2933;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="330" height="220" as="geometry"/></mxCell>
        <mxCell id="orderaccumulator" value="&lt;b&gt;OrderAccumulator&lt;/b&gt; · .NET 10&lt;br&gt;&lt;span style=&quot;color:#52606D&quot;&gt;serviço &lt;i&gt;orderaccumulator&lt;/i&gt; · worker, sem HTTP&lt;/span&gt;&lt;br&gt;&lt;br&gt;FIX acceptor · TCP 9876&lt;br&gt;Limite de exposição por símbolo:&lt;br&gt;&lt;b&gt;R$ 100.000.000,00&lt;/b&gt;&lt;br&gt;Cria as tabelas na subida" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=14;fontFamily=Helvetica;fontColor=#1F2933;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1360" y="330" width="340" height="220" as="geometry"/></mxCell>
        <mxCell id="postgres" value="&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#52606D&quot;&gt;serviço &lt;i&gt;postgres&lt;/i&gt;&lt;/span&gt;&lt;br&gt;porta 5432 · banco &lt;b&gt;flowa&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;align=center;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#1F2933;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1410" y="680" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="datadogmetrics" value="&lt;b&gt;Worker de métricas&lt;/b&gt; · .NET 10&lt;br&gt;&lt;span style=&quot;color:#52606D&quot;&gt;serviço &lt;i&gt;datadogmetrics&lt;/i&gt; · sem porta&lt;/span&gt;&lt;br&gt;A cada 5 min lê exposição e ordens" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=14;fontFamily=Helvetica;fontColor=#1F2933;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="760" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="agente" value="&lt;b&gt;Agente do Datadog&lt;/b&gt;&lt;br&gt;não roda no compose:&lt;br&gt;o envio não chega e o worker&lt;br&gt;só escreve no log" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontFamily=Helvetica;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="e-tela" value="HTTP · GET / (abre a tela)" style="edgeStyle=none;rounded=0;html=1;flowAnimation=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=13;verticalAlign=bottom;fontFamily=Helvetica;fontColor=#1F2933;strokeColor=#1D4ED8;strokeWidth=2;exitX=1;exitY=0.1818;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.1818;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="navegador" target="ordergenerator"><mxGeometry x="0.25" relative="1" as="geometry"><mxPoint x="0" y="-8" as="offset"/></mxGeometry></mxCell>
